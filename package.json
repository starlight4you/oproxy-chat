{
  "name": "oproxy-chat",
  "productName": "Oproxy Chat",
  "version": "0.8.13",
  "description": "Oproxy Chat desktop app for macOS",
  "type": "module",
  "main": "src/main.js",
  "author": "Oproxy",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --remote-debugging-port=9222",
    "dev:mock-model": "node scripts/local-mock-model.mjs",
    "icon": "bash scripts/make-icon.sh",
    "dist": "electron-builder --mac --arm64",
    "dist:universal": "electron-builder --mac --universal",
    "dist:dir": "electron-builder --mac --arm64 --dir",
    "clean": "rm -rf dist",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "electron tests/desktop.mjs",
    "test:provider-icons": "electron tests/provider-icons-ui.mjs",
    "test:endpoint-selector": "electron tests/endpoint-selector-ui.mjs",
    "test:local-mcp-chip": "electron tests/local-mcp-chip-ui.mjs",
    "test:account": "electron tests/account-ui.mjs",
    "test:purchase": "electron tests/purchase-ui.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "release:check": "node scripts/release.mjs --check",
    "dist:release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "world.oproxy.chat",
    "productName": "Oproxy Chat",
    "asar": true,
    "compression": "normal",
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Oproxy Chat 需要使用麦克风进行语音输入。",
        "NSCameraUsageDescription": "Oproxy Chat 需要使用摄像头拍摄并发送图片。",
        "LSApplicationCategoryType": "public.app-category.productivity",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "world.oproxy.chat",
            "CFBundleURLSchemes": [
              "oproxy"
            ]
          }
        ]
      }
    },
    "dmg": {
      "title": "Oproxy Chat ${version}",
      "icon": "build/icon.icns",
      "backgroundColor": "#ffffff",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "docx": "^9.15.3",
    "entities": "^9.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "fast-formula-parser": "^1.0.19",
    "marked": "^18.1.3",
    "pptxgenjs": "^4.0.1",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "image-size": "^2.1.0"
  }
}
